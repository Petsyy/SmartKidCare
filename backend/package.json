{
  "name": "smartkidcare-backend",
  "version": "1.0.0",
  "description": "Smart KidCare Monitoring System Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:csrf": "node --test --require ts-node/register tests/csrf.api.test.ts",
    "test:ai-intent": "node --test --require ts-node/register tests/ai.intentRouting.test.ts",
    "test:ai-evaluation": "python scripts/ragas_evaluation.py --dataset src/data/rag_evaluation_dataset.json --pretty",
    "test:ai-evaluation:quick": "python scripts/ragas_evaluation.py --dataset src/data/rag_evaluation_dataset.json --limit 5 --pretty",
    "test:ai-evaluation:low-cost": "python scripts/ragas_evaluation.py --dataset src/data/rag_evaluation_dataset.json --limit 1 --low-cost --model gemini-2.0-flash-lite --pretty",
    "test:ai-evaluation:runtime": "python scripts/ragas_evaluation.py --dataset src/data/rag_eval.json --pretty",
    "install:py-deps": "pip install -r requirements.txt",
    "diagnose:python": "python scripts/diagnose_python.py",
    "seed:records": "ts-node scripts/seedRecords.ts",
    "check-balance": "ts-node scripts/check-sepolia-balance.ts",
    "import-dataset": "ts-node scripts/importDataset.ts",
    "sanitize-input": "ts-node scripts/sanitizeInput.ts",
    "sanitize-input:py": "python scripts/sanitize_input.py",
    "access-control": "ts-node scripts/accessControlDemo.ts",
    "backfill:rag-dataset": "ts-node scripts/backfillRagDataset.ts",
    "backfill:rag-dataset:dry": "ts-node scripts/backfillRagDataset.ts --dry-run",
    "sync:rag-dataset": "ts-node scripts/syncRagEvaluationDataset.ts",
    "rebuild:rag-benchmark": "ts-node scripts/rebuildBenchmarkEvaluationDataset.ts",
    "eval:rag-benchmark": "npm run rebuild:rag-benchmark && node scripts/runRagasEvaluation.js --dataset src/data/rag_evaluation_dataset.json --metrics faithfulness,answer_relevancy --pretty"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "ethers": "^6.16.0",
    "expo-server-sdk": "^5.0.0",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jws": "^4.0.1",
    "keccak256": "^1.0.6",
    "merkletreejs": "^0.6.0",
    "mongoose": "^9.1.4",
    "morgan": "^1.10.1",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.1",
    "streamifier": "^0.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.2",
    "@types/nodemailer": "^7.0.10",
    "@types/streamifier": "^0.1.2",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
